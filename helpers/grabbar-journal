#!/usr/bin/env python3
"""Grabbar recovery journal: the only code that touches state.json.

    grabbar-journal read        [--state-dir DIR]
    grabbar-journal write       [--state-dir DIR]     (JSON document on stdin)
    grabbar-journal quarantine  [--state-dir DIR] [--reason WORD]
    grabbar-journal inspect     [--state-dir DIR]

`read` prints an envelope {"status": ..., "text": "<raw contents>"} so the
shell validates the document itself (GrabbarModel.parseJournal). `write`
replaces the file atomically (same-directory temp file, fsync, rename),
keeps the previous valid file if anything fails, and refuses symlinks and
foreign-owned paths at every step (spec §7.1, §12). `quarantine` moves a
damaged file aside for diagnostics instead of deleting it. Stdlib only.
"""
from __future__ import annotations

import argparse
import errno
import json
import os
import stat
import sys
import time

MAX_BYTES = 262144
DIR_MODE = 0o700
FILE_MODE = 0o600
STATE_FILE = "state.json"


def default_state_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "grabbar")


def emit(payload: dict) -> None:
    sys.stdout.write(json.dumps(payload, separators=(",", ":")))
    sys.stdout.write("\n")
    sys.stdout.flush()


def ensure_dir(path: str) -> str | None:
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            os.mkdir(path, DIR_MODE)
        except FileExistsError:
            pass
        except OSError as exc:
            return f"mkdir: {exc.strerror}"
        try:
            st = os.lstat(path)
        except OSError as exc:
            return f"lstat: {exc.strerror}"
    except OSError as exc:
        return f"lstat: {exc.strerror}"
    if stat.S_ISLNK(st.st_mode):
        return "state directory is a symlink"
    if not stat.S_ISDIR(st.st_mode):
        return "state path is not a directory"
    if st.st_uid != os.getuid():
        return "state directory is not owned by the current user"
    if st.st_mode & 0o077:
        try:
            os.chmod(path, DIR_MODE)
        except OSError:
            pass
    return None


def classify(path: str) -> tuple[str, os.stat_result | None]:
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return "missing", None
    except OSError:
        return "irregular", None
    if stat.S_ISLNK(st.st_mode):
        return "symlink", st
    if not stat.S_ISREG(st.st_mode):
        return "irregular", st
    if st.st_uid != os.getuid():
        return "irregular", st
    if st.st_size > MAX_BYTES:
        return "oversized", st
    return "ok", st


def read_state(state_dir: str) -> dict:
    path = os.path.join(state_dir, STATE_FILE)
    kind, _ = classify(path)
    if kind == "missing":
        return {"status": "empty", "text": "", "path": path}
    if kind != "ok":
        return {"status": kind, "text": "", "path": path}
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        return {"status": "symlink" if exc.errno == errno.ELOOP else "irregular", "text": "", "path": path}
    try:
        with os.fdopen(fd, "rb") as fh:
            data = fh.read(MAX_BYTES + 1)
    except OSError:
        return {"status": "irregular", "text": "", "path": path}
    if len(data) > MAX_BYTES:
        return {"status": "oversized", "text": "", "path": path}
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return {"status": "invalid", "text": "", "path": path}
    return {"status": "ok", "text": text, "path": path}


def write_state(state_dir: str, text: str) -> dict:
    err = ensure_dir(state_dir)
    if err:
        return {"status": "error", "error": err}
    if len(text.encode("utf-8")) > MAX_BYTES:
        return {"status": "error", "error": "document too large"}
    try:
        doc = json.loads(text)
    except ValueError:
        return {"status": "error", "error": "document is not JSON"}
    if not isinstance(doc, dict) or doc.get("schema") != 1 or not isinstance(doc.get("entries"), list):
        return {"status": "error", "error": "document is not a Grabbar journal"}
    path = os.path.join(state_dir, STATE_FILE)
    kind, _ = classify(path)
    if kind in ("symlink", "irregular"):
        return {"status": "error", "error": f"refusing to replace {kind} at {path}"}
    tmp = os.path.join(state_dir, f".{STATE_FILE}.{os.getpid()}.{int(time.time() * 1000)}.tmp")
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, FILE_MODE)
    except OSError as exc:
        return {"status": "error", "error": f"open temp: {exc.strerror}"}
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(text.encode("utf-8"))
            if not text.endswith("\n"):
                fh.write(b"\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, FILE_MODE)
        os.rename(tmp, path)
        try:
            dfd = os.open(state_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                os.fsync(dfd)
            finally:
                os.close(dfd)
        except OSError:
            pass
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return {"status": "error", "error": f"write: {exc.strerror}"}
    return {"status": "ok", "path": path, "bytes": len(text)}


def quarantine(state_dir: str, reason: str) -> dict:
    path = os.path.join(state_dir, STATE_FILE)
    kind, _ = classify(path)
    if kind == "missing":
        return {"status": "empty"}
    if kind == "symlink":
        # Never follow it; just move the link itself aside.
        pass
    word = "".join(ch for ch in (reason or "damaged") if ch.isalnum() or ch in "-_")[:32] or "damaged"
    target = os.path.join(state_dir, f"state.{int(time.time())}.{word}.quarantined.json")
    try:
        os.rename(path, target)
    except OSError as exc:
        return {"status": "error", "error": f"rename: {exc.strerror}"}
    # keep at most 5 quarantined copies
    try:
        old = sorted(f for f in os.listdir(state_dir) if f.endswith(".quarantined.json"))
        for f in old[:-5]:
            os.unlink(os.path.join(state_dir, f))
    except OSError:
        pass
    return {"status": "ok", "path": target}


def inspect(state_dir: str) -> dict:
    path = os.path.join(state_dir, STATE_FILE)
    kind, st = classify(path)
    out = {"status": kind, "path": path, "dir": state_dir}
    if st is not None:
        out["bytes"] = st.st_size
        out["mode"] = oct(st.st_mode & 0o777)
    try:
        dst = os.lstat(state_dir)
        out["dirMode"] = oct(dst.st_mode & 0o777)
        out["dirIsSymlink"] = stat.S_ISLNK(dst.st_mode)
    except OSError:
        out["dirMode"] = None
    return out


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Grabbar recovery journal")
    ap.add_argument("command", choices=("read", "write", "quarantine", "inspect"))
    ap.add_argument("--state-dir", default=default_state_dir())
    ap.add_argument("--reason", default="damaged")
    args = ap.parse_args(argv)
    if args.command == "read":
        emit(read_state(args.state_dir))
    elif args.command == "write":
        emit(write_state(args.state_dir, sys.stdin.read(MAX_BYTES + 1)))
    elif args.command == "quarantine":
        emit(quarantine(args.state_dir, args.reason))
    else:
        emit(inspect(args.state_dir))
    return 0


if __name__ == "__main__":
    sys.exit(main())
